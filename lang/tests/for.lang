## Iterate range with early exit
for x in 1,4
    print x
    if x == 3
        break
    endif
next
#!1
#!2
#!3

## Iterate array indexes and values with early exit
for i, e in ["hello", "brave", "world"]
    print i, e
    if e == "brave"
        break
    endif
next
#!0 hello
#!1 brave

## Iterate dict keys and values with early exit
for k, v in {"hello":"foo", "strange":"bar", "world":"quux"}
    print k,v
    if k == "strange"
        break
    endif
next
#!hello foo
#!strange bar

## Iterate range with continue statement
for x in 1,4
    if x == 2
        continue
    endif
    print x
next
#!1
#!3
#!4

z = 4
repeat
    z = z - 1
    if z == 2
        continue
    endif
    print z
until z <= 0
#!3
#!1
#!0

stop
