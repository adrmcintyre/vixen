## While statements

## while never iterates if condition False
print "start"
while False
    print "iter"
wend
print "end"
#!start
#!end

## while respects True condition
print "start"
i = 1
while i <= 2
    print "iter"
    i = i + 1
wend
print "end"
#!start
#!iter
#!iter
#!end

## while with continue
i = 0
while i < 4
    i = i + 1
    if i == 2
        continue
    endif
    print i
wend
#!1
#!3
#!4

## while with break
print "start"
while True
    print "iter"
    break
    print "post break"
wend
print "end"
#!start
#!iter
#!end

## break from nested loops
print "start1"
while True
    print "start2"
    while True
        print "iter2"
        break
        print "post break1"
    wend
    print "end2"
    break
    print "post break2"
wend
print "end1"
#!start1
#!start2
#!iter2
#!end2
#!end1

