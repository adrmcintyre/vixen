## repeat loops on False condition
print "start"
i = 1
repeat
    print "iter"
    i = i + 1
until i > 2
print "end"
#!start
#!iter
#!iter
#!end

## repeat with break
print "start"
repeat
    print "iter"
    break
    print "post break"
until False
print "end"
#!start
#!iter
#!end

## repeat with continue
print "start"
i = 0
repeat
    i = i + 1
    if i == 2
        continue
    endif
    print i
until i > 2
print "end"
