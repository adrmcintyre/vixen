class Point
    func add(p1, p2)
        return Point{x: p1.x+p2.x, y:p1.y+p2.y}
    end
    func scale(self, s)
        return Point{x: self.x*s, y:self.y*s}
    end
    func length(self)
        return sqr(self.x*self.x + self.y*self.y)
    end
    func text(self)
        return "(" + str(self.x) + "," + str(self.y) + ")"
    end
end

p = Point{x:10, y:20}
q = Point{x:5, y:5}

print p.text(), q.text()

print p.add(q.scale(4)).length()

