class Point
    x = 0
    y = 0
    func add(p2)
        return Point{x: x+p2.x, y:y+p2.y}
    end
    func scale(s)
        return Point{x: x*s, y:y*s}
    end
    func length()
        return sqr(x*x + y*y)
    end
    func text()
        return "(" + str(x) + "," + str(y) + ")"
    end
end

p = Point{x:10, y:20}
q = Point{x:5, y:5}

print p.text(), q.text()

print p.add(q.scale(4)).length()

